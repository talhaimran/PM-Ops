APP_NAME="PmOps"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=pm_monkey
DB_USERNAME=pm_monkey
DB_PASSWORD=pm_monkey

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# Live updates (3-R15): `reverb`, and fill REVERB_APP_ID, REVERB_APP_KEY and REVERB_APP_SECRET below with random strings.
# Left as `null` or without keys, pages poll every 30 seconds instead.
BROADCAST_CONNECTION=null
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST="localhost"
REVERB_PORT=8080
REVERB_SCHEME=http
# Hosts whose pages may open a live-update socket (comma separated, * wildcards like *.example.com). Empty: the APP_URL host.
REVERB_ALLOWED_ORIGINS=

VITE_REVERB_APP_KEY="${REVERB_APP_KEY}"
VITE_REVERB_HOST="${REVERB_HOST}"
VITE_REVERB_PORT="${REVERB_PORT}"
VITE_REVERB_SCHEME="${REVERB_SCHEME}"

# self_hosted: one workspace, sign-up by invitation after the first person. cloud: anyone signs up, many workspaces, free plan limits
PM_EDITION=self_hosted

# API: requests per minute per token, and how long Idempotency-Key responses are kept
PM_API_RATE_LIMIT=120
PM_IDEMPOTENCY_TTL_HOURS=24

# stdio MCP server identity (php artisan mcp:start pm); create a token at /settings/tokens
PM_MCP_TOKEN=
# MCP OAuth: hosts (https unless a scheme is given; localhost/127.0.0.1 also allow http://localhost:port) and app
# schemes an MCP client may register as its callback. javascript, data, file and vbscript are always refused.
PM_MCP_REDIRECT_DOMAINS=localhost,127.0.0.1,claude.ai,claude.com
PM_MCP_REDIRECT_SCHEMES=cursor,vscode
PM_INVITE_RATE_LIMIT=30

# AI provider (anthropic, openai, google or openai_compatible), model, optional endpoint and key. Set a provider here and
# Settings → AI becomes read-only; leave PM_AI_PROVIDER empty to let Owners and Admins set it there instead
PM_AI_PROVIDER=
PM_AI_MODEL=
PM_AI_ENDPOINT=
PM_AI_KEY=

# Upgrade link in the plan-limit dialog and the Owners' Billing link (Cloud); leave empty on self-hosted.
# The Billing link also needs PM_BILLING_LINK_SECRET (signs its 5-minute token).
PM_BILLING_URL=
PM_BILLING_LINK_SECRET=

# System events for Platform management (Cloud): POSTed and HMAC-signed. Both empty on self-hosted: nothing is recorded.
PM_SYSTEM_EVENTS_URL=
PM_SYSTEM_EVENTS_SECRET=

# Internal admin API (/internal/v1) for Platform management (Cloud). Empty: the API is off and every path is a 404.
# _NEXT is also accepted, so the token can be rotated without downtime. Long random values; never commit them.
PM_INTERNAL_API_TOKEN=
PM_INTERNAL_API_TOKEN_NEXT=

# Google and GitHub sign-in (spec 7.0f); leave empty to hide the button. Callback URLs: APP_URL/auth/google/callback, APP_URL/auth/github/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
