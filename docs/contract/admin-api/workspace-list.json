{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "workspace-list.json",
  "title": "Workspaces (GET /internal/v1/workspaces?updated_since=&cursor=&per_page=)",
  "description": "Every workspace in id order, changed since updated_since (ISO 8601) when given. Pass meta.next_cursor as cursor for the next page; null on the last.",
  "type": "object",
  "required": ["data", "meta"],
  "properties": {
    "data": { "type": "array", "items": { "$ref": "workspace.json#/definitions/workspace" } },
    "meta": {
      "type": "object",
      "required": ["next_cursor"],
      "properties": { "next_cursor": { "type": ["string", "null"] } }
    }
  },
  "examples": [
    {
      "data": [
        {
          "id": 12, "name": "Acme", "slug": "acme", "state": "active",
          "owners": [{ "id": 3, "name": "Olga Owner", "email": "olga@example.com" }],
          "entitlements": {},
          "usage": {
            "billed_users": 1, "viewers": 0, "pending_billed_invitations": 0, "projects": 1, "storage_mb": 0,
            "agents": 0, "api_calls_30d": 0, "last_activity_at": null
          },
          "suspended_at": null, "archived_at": null,
          "created_at": "2026-01-10T08:00:00+00:00", "updated_at": "2026-01-10T08:00:00+00:00"
        }
      ],
      "meta": { "next_cursor": "Mi4yNQ" }
    }
  ]
}
