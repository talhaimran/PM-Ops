{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "workspace.owner_changed",
  "type": "object",
  "required": ["id", "type", "occurred_at", "workspace_id", "usage", "user", "change"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "type": {"const": "workspace.owner_changed"},
    "occurred_at": {"type": "string", "format": "date-time"},
    "workspace_id": {"type": "integer"},
    "usage": {"$ref": "usage.json"},
    "user": {"type": "object", "required": ["id", "email", "name"], "properties": {"id": {"type": "integer"}, "email": {"type": "string"}, "name": {"type": ["string", "null"]}}},
    "change": {"enum": ["added", "removed"]}
  },
  "examples": [
    {"id": "9b2f6c1e-2f0a-4d57-9d1c-0a4b2f6c1e31", "type": "workspace.owner_changed", "occurred_at": "2026-12-05T10:00:00+00:00", "workspace_id": 1,
     "usage": {"billed_users": 2, "viewers": 0, "pending_billed_invitations": 0, "projects": 1, "storage_mb": 0},
     "user": {"id": 2, "email": "new@example.com", "name": "Nia New"}, "change": "added"}
  ]
}
