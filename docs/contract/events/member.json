{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "member.added, member.removed, member.role_changed",
  "type": "object",
  "required": ["id", "type", "occurred_at", "workspace_id", "usage", "user"],
  "properties": {
    "id": {"type": "string", "format": "uuid"},
    "type": {"enum": ["member.added", "member.removed", "member.role_changed"]},
    "occurred_at": {"type": "string", "format": "date-time"},
    "workspace_id": {"type": "integer"},
    "usage": {"$ref": "usage.json"},
    "user": {"type": "object", "required": ["id", "email", "name"], "properties": {"id": {"type": "integer"}, "email": {"type": "string"}, "name": {"type": ["string", "null"]}}},
    "role": {"type": "string"},
    "billed": {"type": "boolean"},
    "scope": {"enum": ["workspace", "project"]},
    "project": {"type": ["string", "null"]},
    "roles": {"type": "object", "required": ["before", "after"], "properties": {"before": {"type": ["string", "null"]}, "after": {"type": ["string", "null"]}}},
    "billed_change": {"type": "object", "required": ["before", "after"], "properties": {"before": {"type": "boolean"}, "after": {"type": "boolean"}}}
  },
  "allOf": [
    {"if": {"properties": {"type": {"enum": ["member.added", "member.removed"]}}}, "then": {"required": ["role", "billed"]}},
    {"if": {"properties": {"type": {"const": "member.role_changed"}}}, "then": {"required": ["scope", "roles", "billed_change"]}}
  ],
  "examples": [
    {"id": "9b2f6c1e-2f0a-4d57-9d1c-0a4b2f6c1e32", "type": "member.role_changed", "occurred_at": "2026-12-05T10:00:00+00:00", "workspace_id": 1,
     "usage": {"billed_users": 2, "viewers": 0, "pending_billed_invitations": 0, "projects": 1, "storage_mb": 0},
     "user": {"id": 2, "email": "v@example.com", "name": "Vic Viewer"}, "scope": "project", "project": "WEB",
     "roles": {"before": "viewer", "after": "member"}, "billed_change": {"before": false, "after": true}}
  ]
}
